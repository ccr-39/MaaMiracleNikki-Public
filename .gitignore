# Python environments, caches and test output
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Local settings and daily state; sanitized examples may be committed
/config/**
/userdata/
!/config/*.example
!/config/*.example.*
!/config/*.template
!/config/*.template.*
!/config/example/
!/config/template/
!/config/example/*.example
!/config/example/*.example.*
!/config/example/*.template
!/config/example/*.template.*
!/config/template/*.example
!/config/template/*.example.*
!/config/template/*.template
!/config/template/*.template.*
.env
.env.*
!.env.example
!.env.template

# Raw device captures and diagnostics; keep recognition templates and other images
/images/screenshots/
/images/debug/
/images/private-assets/
logs/
*.log
*.log.*

# Local credentials, ADB identity and account databases
/.secrets/
/secrets/
/credentials/
adbkey
adbkey.pub
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm

# Generated packages may contain copied local settings and screenshots
/build/
/dist/
/release/
/releases/
/backup/
/backups/
/MaaMiracleNikki-v*-win64.zip
*.zip
*.exe
*.dll
*.pyd
*.onnx
*.egg-info/

# Downloaded dependencies and OCR assets (see tools/setup_ocr.ps1)
node_modules/
/install/
/deps/
/assets/resource/model/ocr/*.onnx
/assets/resource/model/ocr/keys.txt

# Local editor settings, temporary files and OS metadata
.idea/
.vscode/
*.tmp
*.bak
*.swp
*.swo
*~
Thumbs.db
.DS_Store

# Local execution/audit reports; keep originals without publishing machine data
/docs/WINDOWS_PACKAGE_CLEANUP_REPORT.md
/docs/PHASE2_UPDATE_REPORT.md
