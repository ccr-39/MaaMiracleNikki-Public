        "custom_action": "qjnn_home_navigate",
        "custom_action_param": {"target_page": "P2"},
        "rate_limit": 1000,
        "timeout": 15000,
        "next": [
            "QJNN_MailEntry",
            "QJNN_MailSkip"
        ],
        "on_error": [
            "QJNN_MailFailure"
        ]
    },
