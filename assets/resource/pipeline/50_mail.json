{
    "QJNN_Mail": {
        "next": [
            "QJNN_MailRewardResume",
            "QJNN_MailClothesRewardResume",
            "QJNN_MailSystemScreen",
            "QJNN_MailHomeScreen"
        ],
        "on_error": [
            "QJNN_MailFailure"
        ]
    },
    "QJNN_MailRewardResume": {
        "recognition": "And",
        "all_of": [
            {
                "recognition": "OCR",
                "expected": ["^邮箱$"],
                "threshold": 0.8,
                "roi": [120, 120, 480, 140]
            },
            {
                "recognition": "OCR",
                "expected": ["^恭喜获得$", "^获得奖励$"],
                "threshold": 0.8,
                "roi": [120, 240, 480, 180]
            },
            {
                "recognition": "OCR",
                "expected": ["^跳过$", "^确定$"],
                "threshold": 0.8,
                "roi": [0, 880, 720, 310]
            }
        ],
        "action": "DoNothing",
        "max_hit": 1,
        "next": ["QJNN_MailRewardFlow"],
        "on_error": ["QJNN_MailFailure"],
        "focus": {
            "Node.Recognition.Succeeded": "识别到中断后遗留的邮箱奖励页，接续奖励关闭流程，不再次领取。"
        }
    },
    "QJNN_MailClothesRewardResume": {
        "recognition": "And",
        "all_of": [
            "QJNN_MailPageTitle",
