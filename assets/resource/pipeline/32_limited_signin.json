    "QJNN_LimitedSigninResume": {
        "recognition": "Custom",
        "custom_recognition": "qjnn_limited_signin_page",
        "action": "Custom",
        "custom_action": "qjnn_limited_signin",
        "custom_action_param": {"enabled": false},
        "timeout": 120000,
        "on_error": ["QJNN_SafeStop"]
    },
    "QJNN_LimitedSigninHome": {
        "recognition": "Custom",
        "custom_recognition": "qjnn_home_any_page",
