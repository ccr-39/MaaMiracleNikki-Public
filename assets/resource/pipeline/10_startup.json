{
    "QJNN_StartGame": {
        "next": [
            "QJNN_StartApp"
        ]
    },
    "QJNN_StartAndEnterHome": {
        "max_hit": 1,
        "next": [
            "QJNN_PrivateLoginForeground",
            "QJNN_UpdateConfirm",
            "QJNN_InGamePage",
            "QJNN_HomeScreenTemplateGate",
            "QJNN_StartButtonTemplateGate",
            "QJNN_EnterGameScreenTemplateGate",
            "QJNN_QjnnForeground",
            "QJNN_StartAppAndEnterHome"
        ]
    },
    "QJNN_InGamePage": {
        "recognition": "And",
        "all_of": [
            "QJNN_QjnnForeground",
            {
                "recognition": "Or",
                "any_of": [
                    {
                        "recognition": "And",
                        "all_of": [
                            {
                                "recognition": "OCR",
                                "expected": [
                                    "^[0-9]+\\s*/\\s*[0-9]+$"
                                ],
                                "threshold": 0.8,
                                "roi": [
                                    100,
                                    0,
                                    260,
                                    90
                                ]
                            },
                            {
                                "recognition": "OCR",
                                "expected": [
                                    "^[0-9]+$"
                                ],
                                "threshold": 0.8,
                                "roi": [
                                    380,
                                    0,
                                    340,
                                    90
                                ]
                            }
                        ]
                    },
                    {
                        "recognition": "OCR",
                        "expected": [
                            "暖暖月签到",
                            "系统邮件",
                            "搭配师联盟",
                            "搭配竞技场",
                            "搭配评选赛",
                            "织梦人学会",
                            "服装分解",
                            "分解重构",
                            "服装店",
                            "谜之阁",
                            "幻之阁",
                            "世界巡游",
                            "委托任务",
                            "联盟图书馆"
                        ],
                        "threshold": 0.8
                    }
                ]
            }
        ],
        "action": "DoNothing",
        "focus": {
            "Node.Recognition.Succeeded": "已确认游戏内页面，启动完成；后续任务继续处理当前页面。"
        }
    },
    "QJNN_QjnnForeground": {
        "recognition": "Custom",
        "custom_recognition": "qjnn_package_foreground",
        "custom_recognition_param": {
            "package": "com.tencent.tmgp.qjnn"
        },
        "action": "DoNothing",
        "next": [
            "QJNN_WaitForGameState"
        ],
        "on_error": [
            "QJNN_SafeStop"
        ]
    },
    "QJNN_WaitForGameState": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "rate_limit": 1500,
        "timeout": 120000,
        "next": [
            "QJNN_PrivateLoginForeground",
            "QJNN_UpdateConfirm",
            "QJNN_LoginScreen",
            "QJNN_InGamePage",
            "QJNN_HomeScreenTemplateGate",
            "QJNN_HomeScreen",
            "QJNN_StartButton",
            "QJNN_EnterGameScreen"
        ],
        "on_error": [
            "QJNN_SafeStop"
        ],
        "focus": {
            "Node.Action.Starting": "等待奇迹暖暖进入登录、点击开始、进入游戏或首页状态。"
        }
    },
    "QJNN_UpdateConfirm": {
        "recognition": "And",
        "all_of": [
            "QJNN_QjnnForeground",
            {
                "recognition": "OCR",
                "expected": [
                    "检测到有新版本"
                ],
                "threshold": 0.6
            },
            {
                "recognition": "OCR",
                "expected": [
                    "更新包大小"
                ],
                "threshold": 0.6
            },
            {
                "recognition": "OCR",
                "expected": [
                    "^确\\s*定$"
                ],
                "threshold": 0.6
            }
        ],
        "box_index": 3,
        "action": "Click",
        "target": true,
        "max_hit": 1,
        "post_delay": 1500,
        "next": [
            "QJNN_UpdateWait"
        ],
        "on_error": [
            "QJNN_SafeStop"
        ],
        "focus": {
            "Node.Action.Starting": "检测到版本更新，点击确定。"
        }
    },
    "QJNN_UpdateProgressText": {
        "recognition": "OCR",
        "expected": [
            "检测到有新版本",
            "更新包大小",
            "网络环境下进行更",
            "正在.*(更新|下载|解压|校验)",
            "(更新|下载|解压|校验).*(进度|中|完成后)",
            "[0-9]+([.][0-9]+)?\\s*%"
        ],
        "threshold": 0.5
    },
    "QJNN_UpdateWait": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "qjnn_startup_update_wait",
        "timeout": 660000,
        "next": [
            "QJNN_PrivateLoginForeground",
            "QJNN_InGamePage",
            "QJNN_LoginScreenGate",
            "QJNN_StartButtonTemplateGate",
            "QJNN_EnterGameScreenTemplateGate",
            "QJNN_HomeScreenTemplateGate"
        ],
        "on_error": [
            "QJNN_SafeStop"
        ],
        "focus": {
            "Node.Action.Starting": "等待版本更新完成，最多 10 分钟。",
            "Node.Action.Succeeded": "更新等待结束，继续启动流程。"
        }
    },
    "QJNN_StartAppAndEnterHome": {
        "action": "StartApp",
        "package": "com.tencent.tmgp.qjnn",
        "max_hit": 1,
        "post_delay": 1000,
        "rate_limit": 1500,
        "timeout": 120000,
        "next": [
            "QJNN_WaitForGameState"
        ],
        "on_error": [
            "QJNN_SafeStop"
        ],
        "focus": {
            "Node.Action.Starting": "奇迹暖暖当前不在前台，执行一次 StartApp 并等待可处理页面。"
        }
    },
    "QJNN_StartButton": {
        "recognition": "Or",
        "any_of": [
            {
                "recognition": "OCR",
                "expected": [
                    "点击开始"
                ],
                "threshold": 0.3
            },
            {
                "recognition": "TemplateMatch",
                "template": "start/start_button.png",
                "threshold": 0.85
            }
        ],
        "action": "Click",
        "target": true,
        "max_hit": 3,
        "post_delay": 800,
        "rate_limit": 1500,
        "timeout": 20000,
        "next": [
            "QJNN_WaitForGameState"
        ],
        "on_error": [
            "QJNN_SafeStop"
        ]
    },
    "QJNN_LoginScreen": {
        "recognition": "Custom",
        "action": "DoNothing",
        "rate_limit": 2000,
        "timeout": 120000,
        "next": [
            "QJNN_PrivateLoginWait"
        ],
        "on_error": [
            "QJNN_SafeStop"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "检测到登录页面，请手动完成登录。"
        },
        "custom_recognition": "qjnn_login_screen"
    },
    "QJNN_PrivateLoginForeground": {
        "recognition": "Custom",
        "custom_recognition": "qjnn_private_login_foreground",
        "action": "DoNothing",
        "next": [
            "QJNN_PrivateLoginWait"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "检测到第三方登录前台，切换到隐私等待。"
        }
    },
    "QJNN_LoginScreenGate": {
        "recognition": "Custom",
        "action": "DoNothing",
        "next": [
            "QJNN_LoginScreen"
        ],
        "custom_recognition": "qjnn_login_screen"
    },
    "QJNN_StartButtonTemplateGate": {
        "recognition": "TemplateMatch",
        "template": "start/start_button.png",
        "threshold": 0.6,
        "action": "DoNothing",
        "next": [
            "QJNN_StartButton"
        ]
    },
    "QJNN_EnterGameScreenTemplateGate": {
        "recognition": "TemplateMatch",
        "template": "start/enter_game_button.png",
        "threshold": 0.85,
        "action": "DoNothing",
        "next": [
            "QJNN_EnterGameScreen"
        ]
    },
    "QJNN_HomeScreenTemplateGate": {
        "recognition": "Custom",
        "custom_recognition": "qjnn_home_any_page",
        "custom_recognition_param": {
            "strict": true
        },
        "action": "DoNothing",
        "post_delay": 400,
        "next": [
            "QJNN_HomeStable"
        ]
    },
    "QJNN_PrivateLoginWait": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "qjnn_private_login_wait",
        "custom_action_param": {
            "timeout_ms": 300000,
            "interval_ms": 1000
        },
        "timeout": 360000,
        "next": [
            "QJNN_StartButton",
            "QJNN_EnterGameScreen",
            "QJNN_HomeScreen"
        ],
        "on_error": [
            "QJNN_PrivateLoginTimeout"
        ],
        "focus": {
            "Node.Action.Starting": "登录页已进入隐私保护等待；请手动完成 QQ/微信登录。"
        }
    },
    "QJNN_PrivateLoginTimeout": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "next": [
            "QJNN_SafeStop"
        ],
        "focus": {
            "Node.Action.Starting": "登录等待超时，未保存隐私页面截图。"
        }
    },
    "QJNN_EnterGameScreen": {
        "recognition": "Or",
        "any_of": [
            {
                "recognition": "OCR",
                "expected": [
                    "进入游戏"
                ],
                "threshold": 0.3
            },
            {
                "recognition": "TemplateMatch",
                "template": "start/enter_game_button.png",
                "threshold": 0.85
            }
        ],
        "action": "Click",
        "target": true,
        "max_hit": 3,
        "post_delay": 800,
        "rate_limit": 1500,
        "timeout": 20000,
        "next": [
            "QJNN_WaitForGameState"
        ],
        "on_error": [
            "QJNN_SafeStop"
        ]
    },
    "QJNN_HomeScreen": {
        "recognition": "And",
        "all_of": [
            {
                "recognition": "OCR",
                "expected": [
                    "任务"
                ],
                "threshold": 0.3
            },
            {
                "recognition": "OCR",
                "expected": [
                    "好友"
                ],
                "threshold": 0.3
            }
        ],
        "action": "DoNothing",
        "rate_limit": 1000,
        "timeout": 10000,
        "next": [
            "QJNN_HomeStable"
        ],
        "on_error": [
            "QJNN_HomeStableTimeout"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "已通过 OCR 组合条件确认进入主页。"
        }
    },
    "QJNN_HomeStable": {
        "recognition": "Custom",
        "custom_recognition": "qjnn_home_any_page",
        "custom_recognition_param": {
            "strict": true
        },
        "action": "DoNothing",
        "rate_limit": 400,
        "timeout": 5000,
        "on_error": [
            "QJNN_HomeStableTimeout"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "已确认游戏主页，启动完成。"
        }
    },
    "QJNN_HomeStableTimeout": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "next": [
            "QJNN_SafeStop"
        ],
        "focus": {
            "Node.Action.Starting": "[Startup] Home base UI detected, but async home controls did not become ready"
        }
    }
